# ============================================================
# GravityDownload Persian Auto Sub
# Example Environment Configuration
# ============================================================

# OpenAI API Key
# این مقدار را در فایل .env واقعی قرار دهید.
OPENAI_API_KEY=

# Default OpenAI model
OPENAI_MODEL=gpt-5-mini

# Default Whisper model
WHISPER_MODEL=small

# Source language
# خالی = Auto Detect
SOURCE_LANGUAGE=

# Target language
TARGET_LANGUAGE=fa